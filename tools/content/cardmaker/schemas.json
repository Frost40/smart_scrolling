    "type": "object",
    "additionalProperties": false,
    "required": ["cards"],
    "properties": {
      "cards": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "title", "front", "back", "media_alt"],
          "properties": {
            "ref": {"type": "string"},
            "title": {"type": "string"},
            "front": {"type": "string"},
            "back": {"type": "string"},
            "media_alt": {"type": "string"}
          }
        }
      }
    }
  },
